{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Section plan",
  "description": "How one section of a video is retold: its paragraphs in the order told, each with its purpose before its atoms; the atoms that only repeat another, with why before which; then its heading (prompts/plan).",
  "type": "object",
  "additionalProperties": false,
  "required": ["paragraphs", "duplicates", "heading"],
  "properties": {
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "atoms"],
        "properties": {
          "purpose": {"type": "string", "minLength": 1},
          "atoms": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^A[1-9][0-9]{0,8}$"}}
        }
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["because", "atom", "of"],
        "properties": {
          "because": {"type": "string", "minLength": 1},
          "atom": {"type": "string", "pattern": "^A[1-9][0-9]{0,8}$"},
          "of": {"type": "string", "pattern": "^A[1-9][0-9]{0,8}$"}
        }
      }
    },
    "heading": {"type": "string", "minLength": 1}
  }
}
