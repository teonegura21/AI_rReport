{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow comparison",
  "description": "Which of two drafts of a section reads better, the reasons first (prompts/flow).",
  "type": "object",
  "additionalProperties": false,
  "required": ["reasons", "better"],
  "properties": {
    "reasons": {"type": "string", "minLength": 1},
    "better": {"enum": ["first", "second", "tie"]}
  }
}
