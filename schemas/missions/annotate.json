{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Annotation",
  "description": "What a window of a transcript says: facts, must-quotes and terms, each with its evidence first (prompts/annotate, prompts/annotate_more).",
  "type": "object",
  "additionalProperties": false,
  "required": ["facts", "must_quotes", "terms"],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sentences", "quote", "claim", "importance"],
        "properties": {
          "sentences": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S[1-9][0-9]{0,8}$"}},
          "quote": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "importance": {"enum": ["core", "detail"]}
        }
      }
    },
    "must_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sentences", "quote"],
        "properties": {
          "sentences": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S[1-9][0-9]{0,8}$"}},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "meaning"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "meaning": {"type": "string"}
        }
      }
    }
  }
}
