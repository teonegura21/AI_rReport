{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Silver",
  "description": "What a video says, drafted by models for a person to correct into gold: facts, must-quotes and terms, each resting on sentences of the transcript and the exact words they say (rr/eval/annotate.hpp; ADR-0019).",
  "type": "object",
  "additionalProperties": false,
  "required": ["facts", "must_quotes", "terms", "drafted_by"],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sentences", "start_ms", "end_ms", "quote", "claim", "importance", "found"],
        "properties": {
          "sentences": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S[1-9][0-9]{0,8}$"}},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "quote": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "importance": {"enum": ["core", "detail"]},
          "found": {"type": "integer", "minimum": 0}
        }
      }
    },
    "must_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sentences", "start_ms", "end_ms", "quote"],
        "properties": {
          "sentences": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S[1-9][0-9]{0,8}$"}},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "meaning"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "meaning": {"type": "string"}
        }
      }
    },
    "drafted_by": {"type": "string", "minLength": 1}
  }
}
