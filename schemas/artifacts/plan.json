{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "description": "How the article retells the atoms: each section's heading and paragraphs in the order told, the atoms each paragraph tells, and the atoms only another tells (rr/knowledge/plan.hpp).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "duplicates"],
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["first", "heading", "paragraphs", "planned_by"],
        "properties": {
          "first": {"type": "string", "pattern": "^S[1-9][0-9]{0,8}$"},
          "heading": {"type": "string", "minLength": 1},
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["purpose", "atoms"],
              "properties": {
                "purpose": {"type": ["string", "null"], "minLength": 1},
                "atoms": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^A[1-9][0-9]{0,8}$"}}
              }
            }
          },
          "planned_by": {"enum": ["commander", "grouping"]}
        }
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom", "of", "because"],
        "properties": {
          "atom": {"type": "string", "pattern": "^A[1-9][0-9]{0,8}$"},
          "of": {"type": "string", "pattern": "^A[1-9][0-9]{0,8}$"},
          "because": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  }
}
