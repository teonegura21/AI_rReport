{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judgement",
  "description": "An article read by the eval's frozen judges (rr/eval/judgement.hpp): which of its gold's facts it tells, and which of its sentences its video supports, as every judge of the panel read them. A reading has a verdict (or an issue) or says why it is unread.",
  "type": "object",
  "additionalProperties": false,
  "required": ["panel", "judges", "facts", "sentences"],
  "properties": {
    "panel": {"type": "string", "minLength": 1},
    "judges": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "core", "candidates", "readings"],
        "properties": {
          "fact": {"type": "string", "minLength": 1},
          "core": {"type": "boolean"},
          "candidates": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "readings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["judge", "evidence"],
              "properties": {
                "judge": {"type": "string", "minLength": 1},
                "evidence": {"type": "string"},
                "verdict": {"enum": ["told", "partly", "not_told"]},
                "unread": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sentence", "paragraph", "text", "evidence", "readings"],
        "properties": {
          "sentence": {"type": "integer", "minimum": 1},
          "paragraph": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string", "pattern": "^S[1-9][0-9]{0,8}$"}},
          "readings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["judge", "evidence"],
              "properties": {
                "judge": {"type": "string", "minLength": 1},
                "evidence": {"type": "string"},
                "issue": {"enum": ["none", "adds", "softens", "intensifies", "misattributes", "contradicts"]},
                "reading": {"type": ["string", "null"]},
                "unread": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
