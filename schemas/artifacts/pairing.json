{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pairing",
  "description": "Two articles of one video read by the eval's frozen judges, part by part, each part in both orders (rr/eval/flow.hpp): A's version first, then B's. A reading has both orders' preferences and the reasons given, or says why it is unread.",
  "type": "object",
  "additionalProperties": false,
  "required": ["panel", "judges", "parts"],
  "properties": {
    "panel": {"type": "string", "minLength": 1},
    "judges": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["first", "last", "a", "b", "readings"],
        "properties": {
          "first": {"type": "string", "pattern": "^S[1-9][0-9]{0,8}$"},
          "last": {"type": "string", "pattern": "^S[1-9][0-9]{0,8}$"},
          "a": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "b": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "readings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["judge"],
              "properties": {
                "judge": {"type": "string", "minLength": 1},
                "a_first": {"enum": ["first", "second", "tie"]},
                "b_first": {"enum": ["first", "second", "tie"]},
                "reasons": {"type": "string"},
                "unread": {"type": "string", "minLength": 1}
              },
              "anyOf": [
                {"required": ["a_first", "b_first", "reasons"]},
                {"required": ["unread"]}
              ]
            }
          }
        }
      }
    }
  }
}
