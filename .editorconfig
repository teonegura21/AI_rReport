# https://editorconfig.org — keeps every editor consistent with .clang-format.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,toml,ts,tsx,js,mjs,cjs,css,html,inja}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses two trailing spaces as a hard line break.
trim_trailing_whitespace = false

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[Makefile]
indent_style = tab
