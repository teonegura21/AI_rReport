# Compile data files (default configs, SQL migrations, JSON schemas, prompts)
# into the binaries.
#
# Why embed instead of reading from disk: a release binary must be
# self-contained (ADR-0002) and must never run with a migration or schema that
# does not match its code. During development, modules may still accept an
# on-disk override (e.g. prompts) — embedding provides the known-good default.
#
# Mechanism: the generated .cpp stores each file as a `constexpr char[]` of
# '\xNN' character literals. Character literals avoid narrowing problems of
# integer initializers and the greedy-escape pitfall of "\x.." string literals,
# and the result is a fully constexpr std::string_view.
include_guard(GLOBAL)

set(_RR_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/rr_embed_generate.cmake")

# rr_add_embedded_library(<name>
#     NAMESPACE <C++ namespace>     # e.g. rr::embedded::migrations
#     [BASE_DIR <dir>]              # FILES are relative to this (default: project root)
#     FILES <files...>)
#
# Creates `rr_embedded_<name>` (alias `rr::embedded_<name>`) exposing
#   #include <rr/embedded/<name>.hpp>
#   std::span<const File> files();  std::optional<std::string_view> find(path);
function(rr_add_embedded_library name)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "NAMESPACE;BASE_DIR" "FILES")
    if(NOT ARG_NAMESPACE OR NOT ARG_FILES)
        message(FATAL_ERROR "rr_add_embedded_library(${name}): NAMESPACE and FILES are required")
    endif()
    if(NOT ARG_BASE_DIR)
        set(ARG_BASE_DIR "${PROJECT_SOURCE_DIR}")
    endif()

    set(gen_dir "${CMAKE_BINARY_DIR}/generated/embedded/${name}")
    set(header_rel "rr/embedded/${name}.hpp")
    set(header "${gen_dir}/include/${header_rel}")
    set(source "${gen_dir}/${name}.cpp")
    set(manifest "${gen_dir}/manifest.txt")

    # The header's content does not depend on the embedded files, so it is
    # written at configure time: IDEs and dependents always see it. The
    # bracket argument has level 1 ([=[ ... ]=]) because the C++ inside
    # contains "]]" ([[nodiscard]]), which would end a level-0 one early.
    file(CONFIGURE OUTPUT "${header}" @ONLY CONTENT [=[
// Generated by cmake/RrEmbed.cmake — do not edit.
#pragma once

#include <optional>
#include <span>
#include <string_view>

namespace @ARG_NAMESPACE@ {

// One embedded file: its path relative to the project root, and its bytes.
struct File {
    std::string_view path;
    std::string_view content;
};

// All embedded files, in declaration order.
[[nodiscard]] std::span<const File> files() noexcept;

// The content of the file at `path`, or nullopt if it was not embedded.
[[nodiscard]] std::optional<std::string_view> find(std::string_view path) noexcept;

}  // namespace @ARG_NAMESPACE@
]=])

    set(manifest_lines "")
    set(abs_files "")
    foreach(file IN LISTS ARG_FILES)
        cmake_path(ABSOLUTE_PATH file BASE_DIRECTORY "${ARG_BASE_DIR}" OUTPUT_VARIABLE abs)
        if(NOT EXISTS "${abs}")
            message(FATAL_ERROR "rr_add_embedded_library(${name}): file not found: ${abs}")
        endif()
        if(file MATCHES "[\"\\|]")
            message(FATAL_ERROR "rr_add_embedded_library(${name}): unsupported character in '${file}'")
        endif()
        string(APPEND manifest_lines "${file}|${abs}\n")
        list(APPEND abs_files "${abs}")
    endforeach()
    # file(CONFIGURE) only touches the manifest when it changes, so adding or
    # removing a file re-runs the generator but a no-op configure does not.
    file(CONFIGURE OUTPUT "${manifest}" CONTENT "${manifest_lines}")

    add_custom_command(
        OUTPUT "${source}"
        COMMAND "${CMAKE_COMMAND}"
                "-DMANIFEST=${manifest}"
                "-DOUTPUT_SOURCE=${source}"
                "-DNAMESPACE=${ARG_NAMESPACE}"
                "-DHEADER_INCLUDE=${header_rel}"
                -P "${_RR_EMBED_SCRIPT}"
        DEPENDS ${abs_files} "${manifest}" "${_RR_EMBED_SCRIPT}"
        COMMENT "Embedding ${name} (${ARG_FILES})"
        VERBATIM)

    set(target rr_embedded_${name})
    add_library(${target} STATIC "${source}")
    target_include_directories(${target} PUBLIC "${gen_dir}/include")
    target_compile_features(${target} PUBLIC cxx_std_23)
    add_library(rr::embedded_${name} ALIAS ${target})
endfunction()
