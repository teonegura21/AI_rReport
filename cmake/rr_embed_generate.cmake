# Build-time generator for rr_add_embedded_library() (see RrEmbed.cmake).
#
# Invoked as: cmake -DMANIFEST=... -DOUTPUT_SOURCE=... -DNAMESPACE=...
#                   -DHEADER_INCLUDE=... -P rr_embed_generate.cmake
# MANIFEST lines have the form "<relative path>|<absolute path>".
foreach(required IN ITEMS MANIFEST OUTPUT_SOURCE NAMESPACE HEADER_INCLUDE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "rr_embed_generate.cmake: ${required} is not set")
    endif()
endforeach()

file(STRINGS "${MANIFEST}" entries)

set(declarations "")
set(table "")
set(index 0)
foreach(entry IN LISTS entries)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 relative_path)
    list(GET parts 1 absolute_path)

    file(READ "${absolute_path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    if(hex_length EQUAL 0)
        string(APPEND declarations "constexpr std::string_view kContent${index}{};\n")
    else()
        # "2f2a" -> "'\x2f','\x2a',"  (the replacement text below is CMake-escaped)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
        string(APPEND declarations
            "constexpr char kData${index}[] = {${bytes}};\n"
            "constexpr std::string_view kContent${index}{kData${index}, sizeof(kData${index})};\n")
    endif()
    string(APPEND table "    File{\"${relative_path}\", kContent${index}},\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT_SOURCE}.tmp"
"// Generated by cmake/rr_embed_generate.cmake — do not edit.
#include <${HEADER_INCLUDE}>

#include <array>

namespace ${NAMESPACE} {
namespace {

${declarations}
constexpr std::array<File, ${index}> kFiles{{
${table}}};

}  // namespace

std::span<const File> files() noexcept {
    return kFiles;
}

std::optional<std::string_view> find(std::string_view path) noexcept {
    for (const File& file : kFiles) {
        if (file.path == path) {
            return file.content;
        }
    }
    return std::nullopt;
}

}  // namespace ${NAMESPACE}
")

# Replace atomically so an interrupted build never leaves a truncated source.
file(RENAME "${OUTPUT_SOURCE}.tmp" "${OUTPUT_SOURCE}")
